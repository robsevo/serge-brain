{
  "permissions": {
    "allowBypassPermissionsMode": true,
    "additionalDirectories": [
      "__HOME__/programs/serge-0.1.0"
    ]
  },
  "model": "local-coder",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/memory-load.sh",
            "timeout": 10,
            "statusMessage": "Loading Serge memory"
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/progress-load.sh",
            "timeout": 10,
            "statusMessage": "Loading task progress"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/reflexion-load.sh",
            "timeout": 10,
            "statusMessage": "Loading reflexion memory"
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/plan-pointer.sh",
            "timeout": 10,
            "statusMessage": "Checking for saved plan"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/notifications-load.sh",
            "timeout": 10,
            "statusMessage": "Checking loop notifications"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/repo-card.sh",
            "timeout": 15,
            "statusMessage": "Reading repo shape"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/reasoning-overlay.sh",
            "timeout": 10,
            "statusMessage": "Loading reasoning method"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/compact-survival.sh",
            "timeout": 15,
            "statusMessage": "Restoring facts"
          }
        ]
      },
      {
        "matcher": "clear|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/stale-binary-check.sh",
            "timeout": 10,
            "statusMessage": "Checking binary freshness"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/guard-integrity.sh",
            "statusMessage": "Loading Serge memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/auto-consult.sh",
            "timeout": 90,
            "statusMessage": "Consulting reasoning seat"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/research-directive.sh",
            "timeout": 10,
            "statusMessage": "Checking research signals"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/ambiguity-directive.sh",
            "timeout": 10,
            "statusMessage": "Checking for ambiguity"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/logic-directive.sh",
            "timeout": 10,
            "statusMessage": "Checking logic signals"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/complexity-directive.sh",
            "timeout": 10,
            "statusMessage": "Checking complexity"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/docs-directive.sh",
            "statusMessage": "Consulting reasoning seat"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/investigate-directive.sh",
            "statusMessage": "Consulting reasoning seat"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/graph-directive.sh",
            "timeout": 10,
            "statusMessage": "Checking orchestration"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/skill-learn.sh",
            "timeout": 10,
            "statusMessage": "Capturing skill learnings"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/stop-notes-feedback.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/eyes-directive.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/reference-resolve.sh",
            "timeout": 15,
            "statusMessage": "Resolving named paths"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/discovery-delegate.sh",
            "timeout": 15,
            "statusMessage": "Checking discovery signals"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/reasoning-overlay.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/repo-card.sh",
            "timeout": 15,
            "statusMessage": "Checking project changes"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/swarm-brief.sh",
            "timeout": 10,
            "statusMessage": "Checking swarm mode"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/design-directive.sh",
            "timeout": 15,
            "statusMessage": "Loading engineering lenses"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "scout|researcher|Explore",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/subagent-refs-gate.sh",
            "timeout": 15,
            "statusMessage": "Checking subagent sources"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/seat-notes.sh",
            "timeout": 10,
            "statusMessage": "Saving what this seat learned"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/task-evidence-gate.sh",
            "timeout": 20,
            "statusMessage": "Checking task evidence"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input|idle_prompt|agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/notify-desk.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/compact-survival.sh",
            "timeout": 15,
            "statusMessage": "Recording what compaction kept"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/compact-survival.sh",
            "timeout": 20,
            "statusMessage": "Saving facts for compaction"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/repo-card.sh",
            "timeout": 15,
            "statusMessage": "Grounding subagent"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/seat-notes.sh",
            "timeout": 10,
            "statusMessage": "Loading seat notes"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/swarm-doctrine.sh",
            "timeout": 10,
            "statusMessage": "Loading swarm doctrine"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/vague-delete-gate.sh",
            "statusMessage": "Checking eval baseline"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/gate-on-constitution-edit.sh",
            "timeout": 20,
            "statusMessage": "Checking eval baseline"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/path-reality-gate.sh",
            "timeout": 15,
            "statusMessage": "Checking target path"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/subagent-brief-gate.sh",
            "timeout": 10,
            "statusMessage": "Checking subagent brief"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/tool-dedupe-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking duplicate calls"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/plan-gate.sh",
            "timeout": 60,
            "statusMessage": "Inspecting plan"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/semgrep-scan.sh",
            "timeout": 60,
            "statusMessage": "Semgrep scanning edited file"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/algo-gate.sh",
            "timeout": 30,
            "statusMessage": "Checking complexity"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/doc-reality-gate.sh",
            "timeout": 30,
            "statusMessage": "Checking complexity"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/persist-plan.sh",
            "timeout": 10,
            "statusMessage": "Saving plan to plan.md"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/tool-repeat-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking repeat loops"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/tool-dedupe-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking duplicate calls"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/arch-gate.sh",
            "timeout": 120,
            "statusMessage": "Computing architecture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/stop-checks.sh",
            "timeout": 480,
            "statusMessage": "Running stop checks"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/curiosity-capture.sh",
            "statusMessage": "Running stop checks"
          }
        ],
        "matcher": "*"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/explain-on-stop.sh",
            "timeout": 15,
            "statusMessage": "Checking the turn explains itself"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/hooks/on-stop-failure.sh",
            "timeout": 120,
            "statusMessage": "Assessing stop failure"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__SERGE_HOME__/tool-dedupe-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking duplicate calls"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "__SERGE_HOME__/statusline.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
