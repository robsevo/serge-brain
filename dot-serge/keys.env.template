# ─────────────────────────────────────────────────────────────────────────────
#  Serge — the only file you have to fill in.
#
#  You need ONE provider key to start. Not all of them. Everything below that
#  is optional and Serge runs without it.
#
#  After editing:  bash ~/.serge/setup-doctor.sh
#  That checks every key against the real provider and tells you what is
#  missing, so a typo shows up here instead of as a routing error later.
#
#  Keep this file at mode 600 (the installer sets it). It is gitignored.
# ─────────────────────────────────────────────────────────────────────────────


# ── START HERE — pick one ────────────────────────────────────────────────────
#
# Gemini is the easiest: free, no credit card, and it backs BOTH seats Serge
# uses by default, so one key gives you a complete working install.
#
#   https://aistudio.google.com/apikey
#
GEMINI_API_KEY=


# ── More providers (optional — each one adds seats and failover) ─────────────
#
# Serge routes across whatever you give it and falls back when a provider is
# rate-limited or down. More keys means fewer stalls, not more capability.

# Free tier, many models.            https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free tier.                         https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Very fast inference, free tier.    https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# GLM-4.7-Flash, 200K context.       https://z.ai
ZAI_API_KEY=


# ── A spare account for any provider (optional) ──────────────────────────────
#
# Free tiers run out. Add a second account's key with _2 on the end of the same
# name, then run:  bash ~/.serge/rotate-keys.sh
#
# That duplicates every seat backed by that provider so it exists twice, once
# per account. litellm load-balances across them and moves to the other when one
# is throttled or out of quota — so a spent free tier slows you down instead of
# stopping you. _3 and _4 work the same way.
#
#   GEMINI_API_KEY_2=
#   OPENROUTER_API_KEY_2=
#   MISTRAL_API_KEY_2=


# ── Web search (optional) ────────────────────────────────────────────────────
#
# Only WebSearch needs this. WebFetch reads any URL without a key, so Serge can
# still read a page you give it.
#
#   https://app.tavily.com/home
#
TAVILY_API_KEY=


# ── Paid lanes (leave blank unless you want them) ────────────────────────────

# A separate OpenRouter key billed to credit, for the paid seats.
OPENROUTER_PAID_API_KEY=

# AWS Bedrock, for the bedrock-brain seat. Profile lives in ~/.aws/credentials.
AWS_PROFILE=
AWS_REGION_NAME=
